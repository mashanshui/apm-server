{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://apm.example.com/schema/crash-event-v2.json",
  "title": "JVM 与 Native Crash event v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "eventId",
    "eventType",
    "occurredAt",
    "sessionId",
    "processId",
    "anonymousDeviceId",
    "packageName",
    "appVersion",
    "versionCode",
    "buildId",
    "environment",
    "channel",
    "osVersion",
    "deviceModel",
    "crash"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "eventId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "eventType": {
      "const": "crash"
    },
    "occurredAt": {
      "type": "integer",
      "minimum": 0
    },
    "sessionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "processId": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "anonymousDeviceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "packageName": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$",
      "maxLength": 255
    },
    "appVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "versionCode": {
      "type": "integer",
      "minimum": 0
    },
    "buildId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "environment": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "channel": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "osVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "deviceModel": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "networkType": {
      "type": "string",
      "maxLength": 32
    },
    "measurements": {
      "type": "object"
    },
    "attributes": {
      "type": "object"
    },
    "crash": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "fatal"
      ],
      "properties": {
        "kind": {
          "enum": [
            "jvm",
            "native"
          ]
        },
        "fatal": {
          "const": true
        },
        "throwableChain": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/throwable"
          }
        },
        "diagnostics": {
          "anyOf": [
            {
              "$ref": "#/$defs/diagnostics"
            },
            {
              "type": "null"
            }
          ]
        },
        "nativeCrash": {
          "anyOf": [
            {
              "$ref": "#/$defs/nativeCrash"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "jvm"
              }
            }
          },
          "then": {
            "required": [
              "throwableChain"
            ],
            "properties": {
              "nativeCrash": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "native"
              }
            }
          },
          "then": {
            "required": [
              "nativeCrash"
            ],
            "properties": {
              "throwableChain": {
                "type": "null"
              }
            }
          }
        }
      ]
    }
  },
  "$defs": {
    "throwable": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "frames"
      ],
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "message": {
          "type": "string",
          "maxLength": 4096
        },
        "frames": {
          "type": "array",
          "minItems": 1,
          "maxItems": 200,
          "items": {
            "$ref": "#/$defs/frame"
          }
        }
      }
    },
    "frame": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "className",
        "methodName"
      ],
      "properties": {
        "className": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "methodName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "fileName": {
          "type": "string",
          "maxLength": 512
        },
        "lineNumber": {
          "type": "integer",
          "minimum": -1,
          "maximum": 1000000000
        },
        "applicationFrame": {
          "type": "boolean"
        }
      }
    },
    "diagnostics": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "coreTruncation": {
          "anyOf": [
            {
              "$ref": "#/$defs/coreTruncation"
            },
            {
              "type": "null"
            }
          ]
        },
        "crashedThread": {
          "anyOf": [
            {
              "$ref": "#/$defs/crashedThread"
            },
            {
              "type": "null"
            }
          ]
        },
        "otherThreads": {
          "anyOf": [
            {
              "$ref": "#/$defs/otherThreads"
            },
            {
              "type": "null"
            }
          ]
        },
        "logcat": {
          "anyOf": [
            {
              "$ref": "#/$defs/logcat"
            },
            {
              "type": "null"
            }
          ]
        },
        "memory": {
          "anyOf": [
            {
              "$ref": "#/$defs/crashMemory"
            },
            {
              "type": "null"
            }
          ]
        },
        "openFiles": {
          "anyOf": [
            {
              "$ref": "#/$defs/openFiles"
            },
            {
              "type": "null"
            }
          ]
        },
        "process": {
          "anyOf": [
            {
              "$ref": "#/$defs/crashProcess"
            },
            {
              "type": "null"
            }
          ]
        },
        "device": {
          "anyOf": [
            {
              "$ref": "#/$defs/crashDevice"
            },
            {
              "type": "null"
            }
          ]
        },
        "nativeThreads": {
          "anyOf": [
            {
              "$ref": "#/$defs/nativeThreads"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "coreTruncation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "truncated"
      ],
      "properties": {
        "truncated": {
          "type": "boolean"
        },
        "reason": {
          "enum": [
            "size_limit",
            null
          ]
        }
      }
    },
    "crashedThread": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "truncated"
      ],
      "properties": {
        "status": {
          "enum": [
            "ok",
            "partial",
            "unavailable",
            "skipped"
          ]
        },
        "reason": {
          "enum": [
            "permission_denied",
            "unsupported",
            "timeout",
            "io_error",
            "memory_pressure",
            "interrupted",
            "size_limit",
            "count_limit",
            null
          ]
        },
        "truncated": {
          "type": "boolean"
        },
        "capturedAt": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "javaId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,18}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "name": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 512
            },
            {
              "type": "null"
            }
          ]
        },
        "state": {
          "anyOf": [
            {
              "enum": [
                "NEW",
                "RUNNABLE",
                "BLOCKED",
                "WAITING",
                "TIMED_WAITING",
                "TERMINATED"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "priority": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 10
            },
            {
              "type": "null"
            }
          ]
        },
        "daemon": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "mainThread": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "systemTid": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 2147483647
        }
      }
    },
    "otherThread": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "javaId",
        "name",
        "state",
        "priority",
        "daemon",
        "mainThread",
        "truncated",
        "frames"
      ],
      "properties": {
        "javaId": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,18}$"
        },
        "name": {
          "type": "string",
          "maxLength": 512
        },
        "state": {
          "enum": [
            "NEW",
            "RUNNABLE",
            "BLOCKED",
            "WAITING",
            "TIMED_WAITING",
            "TERMINATED"
          ]
        },
        "priority": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "daemon": {
          "type": "boolean"
        },
        "mainThread": {
          "type": "boolean"
        },
        "truncated": {
          "type": "boolean"
        },
        "frames": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/frame"
          }
        },
        "systemTid": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            },
            {
              "type": "null"
            }
          ]
        },
        "relationToCrash": {
          "enum": [
            "other",
            "unknown",
            null
          ]
        }
      }
    },
    "otherThreads": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "truncated",
        "threads"
      ],
      "properties": {
        "status": {
          "enum": [
            "ok",
            "partial",
            "unavailable",
            "skipped"
          ]
        },
        "reason": {
          "enum": [
            "permission_denied",
            "unsupported",
            "timeout",
            "io_error",
            "memory_pressure",
            "interrupted",
            "size_limit",
            "count_limit",
            null
          ]
        },
        "truncated": {
          "type": "boolean"
        },
        "capturedAt": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "observedCount": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 2147483647
        },
        "omittedCount": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 2147483647
        },
        "threads": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/otherThread"
          }
        }
      }
    },
    "logcatBuffer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "truncated",
        "lines"
      ],
      "properties": {
        "status": {
          "enum": [
            "ok",
            "partial",
            "unavailable",
            "skipped"
          ]
        },
        "reason": {
          "enum": [
            "permission_denied",
            "unsupported",
            "timeout",
            "io_error",
            "memory_pressure",
            "interrupted",
            "size_limit",
            "count_limit",
            null
          ]
        },
        "truncated": {
          "type": "boolean"
        },
        "capturedAt": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "lines": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "type": "string",
            "maxLength": 2048
          }
        }
      }
    },
    "logcat": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "truncated"
      ],
      "properties": {
        "status": {
          "enum": [
            "ok",
            "partial",
            "unavailable",
