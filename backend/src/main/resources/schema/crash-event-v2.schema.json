          ]
        },
        "truncated": {
          "type": "boolean"
        },
        "capturedAt": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "main": {
          "anyOf": [
            {
              "$ref": "#/$defs/logcatBuffer"
            },
            {
              "type": "null"
            }
          ]
        },
        "system": {
          "anyOf": [
            {
              "$ref": "#/$defs/logcatBuffer"
            },
            {
              "type": "null"
            }
          ]
        },
        "events": {
          "anyOf": [
